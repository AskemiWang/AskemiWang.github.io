          <mxGeometry x="150" y="820" width="600" height="10" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="exit_group(0)　ls 退出，Shell 的 waitpid() 返回" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="150" y="850" width="600" height="55" as="geometry" />
        </mxCell>

        <mxCell id="note" value="这些都是普通系统调用：ls 没有任何特权，只能通过它们请求内核。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
